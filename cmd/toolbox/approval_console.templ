package main

import (
	"fmt"
	"strings"

	"github.com/solidarity-ai/toolbox/daemon"
)

templ ApprovalConsolePage(page daemonIndexPageData, state approvalConsoleState) {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Toolbox Approvals</title>
			<style>
				:root { color-scheme: light; --border:#d8dde3; --muted:#5d6673; --bg:#f7f8fa; --text:#15181d; --accent:#1967d2; --ok:#16833a; --danger:#b42318; }
				* { box-sizing: border-box; }
				body { margin: 0; background: var(--bg); color: var(--text); font: 14px/1.45 -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
				button, input, textarea { font: inherit; }
				button { border: 1px solid var(--border); background: #fff; border-radius: 6px; padding: 0.42rem 0.7rem; cursor: pointer; }
				button.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
				button:disabled { opacity: .5; cursor: not-allowed; }
				.link-button { border:0; background:transparent; color:#0957d0; padding:.2rem .35rem; }
				.icon-button { width:32px; height:32px; display:inline-grid; place-items:center; padding:0; border-radius:8px; color:#243047; background:#fff; }
				.toolbar-icon { width:16px; height:16px; flex:0 0 auto; stroke:currentColor; fill:none; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; }
				.client-icon { width:20px; height:20px; }
				.toolbar-count { font-weight:700; color:#1f2937; }
				.icon-button .toolbar-icon { width:17px; height:17px; }
				.topbar { position: sticky; top: 0; z-index: 10; display: flex; align-items: center; gap: .75rem; padding: .75rem 1.5rem; background: rgba(255,255,255,.96); border-bottom: 1px solid var(--border); }
				.brand { display:flex; align-items:center; gap:.65rem; font-weight: 700; font-size: 16px; margin-right: auto; }
				.brand-mark { width:28px; height:28px; display:inline-grid; place-items:center; border-radius:7px; background:#111827; color:#fff; font-weight:800; line-height:1; }
				.brand-pending { min-width:1.45rem; height:1.35rem; display:inline-grid; place-items:center; padding:0 .45rem; border-radius:999px; background:#eef4ff; color:#0b57d0; font-size:12px; font-weight:700; line-height:1; }
				.pill { display:inline-flex; align-items:center; gap:.4rem; color: var(--muted); white-space: nowrap; }
				.toolbar-pill { height:32px; display:inline-flex; align-items:center; justify-content:center; gap:.4rem; padding:0 .6rem; border:1px solid var(--border); border-radius:8px; background:#fff; color:#344054; font-size:13px; line-height:1; white-space:nowrap; }
				.toolbar-button { cursor:pointer; }
				.topbar-popover, .topbar-menu { position:relative; }
				.topbar-menu { margin:0; }
				.topbar-menu summary { width:auto; color:#344054; list-style:none; }
				.topbar-menu summary::-webkit-details-marker { display:none; }
				.topbar-menu summary::after { content:""; margin:0; }
				.topbar-menu[open] > summary { background:#f6f8fb; }
				.live-target { width:32px; height:32px; display:inline-grid; place-items:center; border-radius:8px; }
				.live-target:focus-visible { outline:2px solid #9ec1ff; outline-offset:2px; }
				.dot.toolbar-dot { width:.65rem; height:.65rem; margin:0; }
				.topbar-tooltip { position:absolute; right:0; top:calc(100% + .45rem); z-index:30; display:none; width:max-content; max-width:min(18rem, calc(100vw - 2rem)); padding:.45rem .55rem; border:1px solid #111827; border-radius:7px; background:#111827; color:#fff; box-shadow:0 8px 24px rgba(15,23,42,.22); font-size:12px; line-height:1.35; white-space:nowrap; }
				.topbar-popover:hover .topbar-tooltip, .topbar-popover:focus-within .topbar-tooltip { display:block; }
				.topbar-panel { position:absolute; right:0; top:calc(100% + .45rem); z-index:30; width:min(30rem, calc(100vw - 2rem)); max-width:calc(100vw - 2rem); padding:.35rem; border:1px solid var(--border); border-radius:8px; background:#fff; box-shadow:0 12px 30px rgba(15,23,42,.16); }
				.client-empty { padding:.7rem .8rem; color:var(--muted); }
				.client-row { padding:.65rem .7rem; border-bottom:1px solid #edf0f3; }
				.client-row:last-child { border-bottom:0; }
				.client-title { display:flex; align-items:center; gap:.5rem; min-width:0; color:var(--text); font-weight:650; }
				.client-title .dot { margin:0; flex:0 0 auto; }
				.client-title-text { min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
				.client-facts { display:grid; grid-template-columns:6.5rem minmax(0,1fr); gap:.18rem .65rem; margin-top:.45rem; font-size:12px; }
				.client-facts .label { color:var(--muted); }
				.client-facts .value { overflow-wrap:anywhere; }
				.lock-button.unlocked { color:var(--ok); }
				.lock-button.locked { color:var(--danger); }
				.lock-button.unavailable { color:#6b7280; }
				.lock-button .toolbar-icon { width:20px; height:20px; stroke-width:2.1; }
				.ok-text { color:#0b8f43; }
				.danger-text { color:var(--danger); }
				.dot { display:inline-block; width:.55rem; height:.55rem; border-radius:999px; background: var(--ok); margin-right:.35rem; }
				.dot.warn { background:#c77700; } .dot.off { background:#9aa2ad; }
				main { max-width: none; margin: .9rem auto 3rem; padding: 0 1.25rem; }
				.message { min-height: 1.3rem; color: var(--danger); white-space: pre-wrap; }
				.secret-panel { display:none; max-width:32rem; margin:2rem auto 1rem; padding:1.25rem; border:1px solid var(--border); background:#fff; border-radius:12px; box-shadow:0 10px 30px rgba(15,23,42,.08); }
				.secret-panel.open { display:block; }
				.secret-panel-card { display:grid; gap:.85rem; }
				.secret-panel-eyebrow { margin:0; color:var(--muted); font-size:12px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; }
				.secret-panel h2 { margin:0; font-size:22px; line-height:1.2; }
				.secret-panel-subtitle { margin:0; color:var(--muted); }
				.secret-panel form { display:grid; gap:.7rem; }
				.secret-panel label { font-weight:650; }
				.secret-panel input { width:100%; min-width:0; border:1px solid var(--border); border-radius:8px; padding:.62rem .7rem; }
				.secret-panel .primary { width:100%; padding:.6rem .8rem; }
				.secret-panel-note { margin:.15rem 0 0; color:var(--muted); font-size:13px; }
				.backup-codes { display:none; margin:.75rem 0 0; padding:.75rem; border:1px solid #b7d4ff; background:#f4f8ff; border-radius:7px; }
				.backup-codes.open { display:block; }
				.backup-codes h3 { margin:0 0 .35rem; font-size:14px; }
				.backup-codes p { margin:.2rem 0 .55rem; color:var(--muted); }
				.backup-codes pre { background:#fff; }
				.intent { background:#fff; border:1px solid var(--border); border-radius:8px; margin:1rem 0; padding:1rem 1rem 0; overflow:hidden; box-shadow:0 1px 2px rgba(15,23,42,.04); }
				.intent-head { display:block; margin-bottom:.75rem; }
				.intent-primary { display:flex; align-items:center; gap:.65rem; }
				.intent-title { font-size:16px; font-weight:650; flex:1; min-width:0; }
				.intent-meta-row { display:flex; align-items:center; gap:.75rem; margin-top:.55rem; padding-left:1.45rem; }
				.intent-meta { color:var(--muted); font-size:13px; font-weight:400; margin-right:auto; }
				.session-popover { position:relative; }
				.session-tooltip { position:absolute; right:0; top:calc(100% + .45rem); z-index:20; display:none; width:max-content; max-width:min(28rem, calc(100vw - 2rem)); padding:.7rem .8rem; border:1px solid var(--border); border-radius:8px; background:#111827; color:#fff; box-shadow:0 8px 24px rgba(15,23,42,.22); font-size:12px; line-height:1.5; white-space:pre-line; }
				.session-popover:hover .session-tooltip, .session-popover:focus-within .session-tooltip { display:block; }
				.intent-menu { position:relative; margin:0; }
				.intent-menu summary { list-style:none; }
				.intent-menu summary::-webkit-details-marker { display:none; }
				.intent-menu summary::after { content:""; margin:0; }
				.menu-panel { position:absolute; right:0; top:calc(100% + .35rem); z-index:15; min-width:11rem; padding:.35rem; border:1px solid var(--border); border-radius:8px; background:#fff; box-shadow:0 8px 24px rgba(15,23,42,.16); }
				.menu-panel button { width:100%; border:0; text-align:left; background:#fff; padding:.42rem .55rem; }
				.menu-panel button:hover { background:#f5f7fa; }
				.package { margin:.55rem 0 .9rem; padding:.8rem .75rem .35rem; border:1px solid #e5e9ef; border-radius:7px; background:#fff; }
				.package-title { display:flex; align-items:center; gap:.55rem; font-weight:700; padding-bottom:.55rem; border-bottom:1px solid var(--border); font-size:15px; }
				.count-badge { min-width:1.35rem; height:1.35rem; display:inline-grid; place-items:center; padding:0 .4rem; border-radius:999px; background:#eef4ff; color:#0b57d0; font-size:12px; font-weight:700; }
				.row { padding:.75rem 0; border-bottom:1px solid #edf0f3; }
				.row:last-child { border-bottom:0; padding-bottom:0; }
				.row-head { display:grid; grid-template-columns:auto minmax(0,1fr) auto; gap:.8rem; align-items:center; }
				.tool-name { display:flex; align-items:center; gap:.45rem; font-weight:650; white-space:nowrap; min-width:0; }
				.tool-name-text { overflow:hidden; text-overflow:ellipsis; }
				.tool-icon { width:24px; height:24px; object-fit:contain; flex:0 0 24px; }
				.desc { color:var(--muted); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
				.seg { display:inline-flex; border:1px solid var(--border); border-radius:7px; overflow:hidden; height:32px; background:#fff; }
				.seg button { border:0; border-right:1px solid var(--border); border-radius:0; padding:0 .55rem; width:5.4rem; font-size:13px; }
				.seg button:last-child { border-right:0; }
				.seg button.active { background:#eaf2ff; color:#174ea6; font-weight:650; }
				.seg button.reject.active { background:#fff0ee; color:var(--danger); }
				.sent { color:var(--muted); font-size:13px; }
				.summary { display:grid; grid-template-columns:minmax(7rem, 12rem) minmax(0,1fr); gap:.25rem 1rem; margin-top:.55rem; }
				.label { color:var(--muted); }
				.value { overflow-wrap:anywhere; }
				details { margin-top:.45rem; }
				summary { color:var(--accent); cursor:pointer; width:fit-content; list-style:none; }
				summary::-webkit-details-marker { display:none; }
				summary::after { content:"v"; margin-left:.45rem; font-size:12px; }
				details[open] summary::after { content:"^"; }
				.topbar-menu > summary::after, .topbar-menu[open] > summary::after, .intent-menu > summary::after, .intent-menu[open] > summary::after { content:""; margin:0; }
				pre { margin:.35rem 0 0; padding:.75rem; background:#f4f6f8; border:1px solid var(--border); border-radius:6px; overflow:auto; white-space:pre-wrap; }
				.details-grid { display:grid; grid-template-columns:9rem minmax(0,1fr); gap:.35rem .8rem; margin-top:.6rem; }
				.footer { position:sticky; bottom:0; display:flex; align-items:center; gap:.75rem; margin:.25rem -1rem 0; padding:.75rem 1rem; background:#fbfcfd; border-top:1px solid var(--border); box-shadow:0 -1px 2px rgba(15,23,42,.04); }
				.footer .counts { margin-right:auto; color:var(--muted); }
				.empty { text-align:center; color:var(--muted); padding:4rem 1rem; border:1px dashed var(--border); background:#fff; border-radius:8px; }
				dialog { border:1px solid var(--border); border-radius:8px; padding:1rem; max-width:420px; width:calc(100% - 2rem); }
				dialog textarea { width:100%; min-height:5rem; margin:.5rem 0; border:1px solid var(--border); border-radius:6px; padding:.5rem; }
				dialog::backdrop { background: rgba(20, 24, 29, .25); }
				.dialog-actions { display:flex; justify-content:flex-end; gap:.5rem; }
				@media (max-width: 700px) { .topbar { flex-wrap:wrap; padding:.75rem 1rem; } main { padding:0 .75rem; } .intent-meta-row { align-items:flex-start; flex-wrap:wrap; padding-left:0; } .row-head { grid-template-columns:1fr; } .desc { display:none; } .summary,.details-grid { grid-template-columns:1fr; } .footer { flex-wrap:wrap; } }
			</style>
			<script type="module" src="/assets/datastar-v1.0.1.js"></script>
		</head>
		<body
			data-signals={ approvalConsoleInitialSignals(state) }
			data-init="@get('/approval-console/events', {payload:{}})"
			data-on:datastar-fetch__window={ datastarFetchStateExpr() }
		>
			@ApprovalTopbar(state)
			<main>
				<p style="position:absolute;left:-10000px;">Status: <strong id="status">{ page.StatusText }</strong></p>
				@SecretPanel(page)
				<p class="message" id="message" data-text="$message"></p>
				@ApprovalMain(state)
				@RejectDialog()
			</main>
		</body>
	</html>
}

templ ApprovalTopbar(state approvalConsoleState) {
	<header class="topbar" id="approval-topbar">
		<div class="brand">
			<span class="brand-mark" aria-hidden="true">T</span>
			<span>Toolbox</span>
			if state.Summary.PendingApprovals > 0 {
				<span class="brand-pending" aria-label="Pending approvals" title="Pending approvals">{ fmt.Sprintf("%d", state.Summary.PendingApprovals) }</span>
			}
		</div>
		<div class="topbar-popover" id="live-state">
			<span class="live-target" tabindex="0" aria-label="Live update status" aria-describedby="live-state-tooltip">
				<span class="dot toolbar-dot" data-class={ liveDotClassExpr() }></span>
			</span>
			<div class="topbar-tooltip" id="live-state-tooltip" role="tooltip"><span data-text="$liveState">Connecting</span></div>
		</div>
		<details class="topbar-menu client-popover" id="client-count" data-preserve-attr="open">
			<summary class="toolbar-pill toolbar-button" aria-label="Connected clients" title="Connected clients">
				@IconClients()
				<span class="toolbar-count">{ fmt.Sprintf("%d", state.Summary.ActiveClients) }</span>
			</summary>
			<div class="topbar-panel clients-panel">
				@ClientPopover(state)
			</div>
		</details>
		<button type="button" class={ lockButtonClass(state.SecretStore.Status) } aria-label={ secretStoreIconLabel(state.SecretStore.Status) } title={ secretStoreIconLabel(state.SecretStore.Status) } data-on:click="$secretOpen = !$secretOpen">
			@IconLock(state.SecretStore.Status)
		</button>
	</header>
}

templ ClientPopover(state approvalConsoleState) {
	if len(state.Clients) == 0 {
		<div class="client-empty">No connected clients</div>
	} else {
		for _, client := range state.Clients {
			<div class="client-row">
				<div class="client-title">
					if client.Active {
						<span class="dot"></span>
					} else {
						<span class="dot off"></span>
					}
					<span class="client-title-text">{ approvalClientTitle(client) }</span>
				</div>
				<div class="client-facts">
					if client.Host != "" {
						<div class="label">Host</div><div class="value">{ client.Host }</div>
					}
					if client.ParentCommand != "" {
						<div class="label">Parent</div><div class="value">{ approvalClientParentLabel(client) }</div>
					}
					if client.Mode != "" {
						<div class="label">Mode</div><div class="value">{ client.Mode }</div>
					}
					if client.BoundTBSession != "" {
						<div class="label">Session</div><div class="value">{ client.BoundTBSession }</div>
					}
					if client.WorkingDir != "" {
						<div class="label">Directory</div><div class="value">{ client.WorkingDir }</div>
					}
					<div class="label">Approvals</div><div class="value">{ fmt.Sprintf("%d pending", client.PendingApprovals) }</div>
					<div class="label">Tools</div><div class="value">{ fmt.Sprintf("%d prepared", client.PreparedTools) }</div>
					if client.LastSyncAt != "" {
						<div class="label">Last sync</div><div class="value">{ displayTime(client.LastSyncAt) }</div>
					}
					if client.ConnectedAt != "" {
						<div class="label">Connected</div><div class="value">{ displayTime(client.ConnectedAt) }</div>
					}
				</div>
			</div>
		}
	}
}

templ IconClients() {
	<svg class="toolbar-icon client-icon" viewBox="0 0 24 24" aria-hidden="true">
		<rect x="4" y="5" width="16" height="14" rx="2"></rect>
		<path d="M4 8h16"></path>
		<rect x="8" y="10.5" width="8" height="5.5" rx="1.5"></rect>
		<path d="M12 10.5V9"></path>
		<circle cx="10.3" cy="13.2" r=".35"></circle>
		<circle cx="13.7" cy="13.2" r=".35"></circle>
		<path d="M10.5 15h3"></path>
	</svg>
}

templ IconLock(status string) {
	<svg class="toolbar-icon" viewBox="0 0 24 24" aria-hidden="true">
		if secretIconStatus(status) == "unlocked" {
			<path d="M7 10V7a5 5 0 0 1 9.8-1.4"></path>
		} else {
			<path d="M7 10V7a5 5 0 0 1 10 0v3"></path>
		}
		<rect x="4" y="10" width="16" height="10" rx="2"></rect>
		<path d="M12 14v2"></path>
	</svg>
}

templ SecretPanel(page daemonIndexPageData) {
	<section id="secret-panel" class={ secretPanelClass(page) } data-class={ secretPanelClassExpr(page) }>
		if page.Available {
			if page.Locked {
				<div class="secret-panel-card">
					<p class="secret-panel-eyebrow">Toolbox Secret Store</p>
					if page.SetupRequired {
						<h2>Create your toolbox secret store</h2>
						<p class="secret-panel-subtitle">Create an encrypted Secret Store to save credentials for Toolbox tools.</p>
						<form id="unlock-form" method="post" action="/secret-store/unlock" data-on:submit__prevent="@post('/secret-store/unlock', {payload:{unlock_key:el.querySelector('[name=unlock_key]').value, setup:true}})">
							<label for="unlock-key">Create a passphrase</label>
							<input id="unlock-key" name="unlock_key" type="password" autocomplete="new-password" placeholder="Choose a passphrase" data-bind:unlock-key/>
							<button type="submit" class="primary">Create Secret Store</button>
							<p class="secret-panel-note">After setup, Toolbox will show backup codes once. Save them in your password manager.</p>
						</form>
					} else {
						<h2>Secret Store Locked</h2>
						<p class="secret-panel-subtitle">Unlock the Secret Store to approve tools that need credentials.</p>
						<form id="unlock-form" method="post" action="/secret-store/unlock" data-on:submit__prevent="@post('/secret-store/unlock', {payload:{unlock_key:el.querySelector('[name=unlock_key]').value, setup:false}})">
							<label for="unlock-key">Passphrase</label>
							<input id="unlock-key" name="unlock_key" type="password" autocomplete="current-password" placeholder="Passphrase or backup code" data-bind:unlock-key/>
							<button type="submit" class="primary">Unlock</button>
						</form>
					}
				</div>
				<div id="backup-codes" class="backup-codes" data-class="{'open': $backupCodesText !== ''}">
					<h3>Backup codes</h3>
					<p>Save these long backup codes in your password manager. Toolbox does not store them and cannot show them again.</p>
					<pre data-text="$backupCodesText"></pre>
				</div>
			} else {
				<div class="secret-panel-card">
					<p class="secret-panel-eyebrow">Toolbox Secret Store</p>
					<h2>Secret Store Unlocked</h2>
					if page.RecoveryUnlocked {
						<p class="secret-panel-subtitle">Generate new backup codes for this recovery session.</p>
						<form id="recovery-codes-form" method="post" action="/secret-store/recovery-codes" data-on:submit__prevent="@post('/secret-store/recovery-codes', {payload:{}})">
							<button type="submit" class="primary">Generate new backup codes</button>
						</form>
					} else {
						<p class="secret-panel-subtitle">Confirm your passphrase to generate new backup codes.</p>
						<form id="recovery-codes-form" method="post" action="/secret-store/recovery-codes" data-on:submit__prevent="@post('/secret-store/recovery-codes', {payload:{unlock_key:el.querySelector('[name=unlock_key]').value}})">
							<label for="recovery-unlock-key">Passphrase</label>
							<input id="recovery-unlock-key" name="unlock_key" type="password" autocomplete="current-password" placeholder="Confirm passphrase"/>
							<button type="submit" class="primary">Generate new backup codes</button>
						</form>
					}
					<form id="lock-form" method="post" action="/secret-store/lock" data-on:submit__prevent="@post('/secret-store/lock', {payload:{}})">
						<button type="submit">Lock Secret Store</button>
					</form>
				</div>
				<div id="backup-codes" class="backup-codes" data-class="{'open': $backupCodesText !== ''}">
					<h3>Backup codes</h3>
					<p>Save these long backup codes in your password manager. Toolbox does not store them and cannot show them again.</p>
					<pre data-text="$backupCodesText"></pre>
				</div>
			}
		} else {
			Secret store unavailable.
		}
	</section>
}

templ ApprovalMain(state approvalConsoleState) {
	<section id="approval-main">
		if state.Summary.ActiveClients == 0 {
			<div class="empty"><h2>No active Toolbox sessions</h2><p>Start a codemode session to review tool approvals here.</p></div>
		} else if len(state.Sessions) == 0 {
			<div class="empty"><h2>Awaiting Approvals</h2><p>Tool use approvals will display here when required.</p></div>
		} else {
			for _, session := range state.Sessions {
				@ApprovalSession(session)
			}
		}
	</section>
}

templ ApprovalSession(session approvalConsoleSession) {
	<section class="intent" id={ approvalSessionID(session) } data-session={ session.TBSession }>
		<div class="intent-head">
			<div class="intent-primary">
				if session.Active {
					<span class="dot"></span>
				} else {
					<span class="dot off"></span>
				}
				<div class="intent-title">"{ session.Intent.Text }"</div>
				<div class="session-popover">
					<button type="button" class="icon-button" aria-label="Session details" aria-describedby={ approvalSessionTooltipID(session) }>i</button>
					<div class="session-tooltip" id={ approvalSessionTooltipID(session) } role="tooltip">
						if session.Active {
							Session { session.TBSession }&#10;{ firstNonEmpty(session.Details.Mode, "codemode") } - PID { fmt.Sprintf("%d", session.Details.PID) }&#10;{ session.Details.WorkingDir }&#10;Synced { displayTime(session.Details.LastSyncAt) }
						} else {
							Session disconnected&#10;Last sync { displayTime(session.Details.LastSyncAt) }
						}
					</div>
				</div>
			</div>
			<div class="intent-meta-row">
				<div class="intent-meta">{ fmt.Sprintf("%d pending", countConsoleSessionCalls(session)) } &middot; Updated { displayTime(session.UpdatedAt) }</div>
				<button type="button" class="link-button" data-on:click={ setSessionDraftsExpr(session, "approve") }>Mark all approved</button>
				<details class="intent-menu" data-preserve-attr="open">
					<summary class="icon-button" aria-label="More actions" title="More actions">...</summary>
					<div class="menu-panel">
						<button type="button" data-on:click={ submitAllSessionExpr(session, "approve") }>Approve all</button>
						<button type="button" data-on:click={ openRejectAllSessionExpr(session) }>Reject all</button>
					</div>
				</details>
			</div>
		</div>
		for _, group := range session.PackageGroups {
			@ApprovalPackage(session, group)
		}
		@ApprovalFooter(session)
	</section>
}

templ ApprovalPackage(session approvalConsoleSession, group approvalConsolePackageGroup) {
	<section class="package" id={ approvalPackageID(session, group) }>
		<div class="package-title">
			<span>{ firstNonEmpty(group.PackageLabel, group.PackageKey) }</span>
			<span class="count-badge">{ fmt.Sprintf("%d", len(group.ToolCalls)) }</span>
		</div>
		for _, call := range group.ToolCalls {
			@ApprovalRow(call)
		}
	</section>
}

templ ApprovalRow(call daemon.PendingApprovalSnapshot) {
	<div class="row" id={ approvalRowID(call.ToolCallID) } data-tool-call-id={ call.ToolCallID }>
		<div class="row-head">
			<div class="tool-name">
				if iconURI := approvalDisplayIconDataURI(call); iconURI != "" {
					<img class="tool-icon" src={ iconURI } alt={ approvalDisplayIconAlt(call) } width="24" height="24"/>
				}
				<span class="tool-name-text">{ approvalDisplayTitle(call) }</span>
			</div>
			<div class="desc">{ approvalDisplayDescription(call) }</div>
			if call.QueuedDecision != nil {
				<div class="sent">Decision sent - Waiting for session...</div>
			} else {
				<div class="seg">
					<button type="button" class="reject" data-on:click={ decisionToggleExpr(call.ToolCallID, "reject") } data-class={ decisionClassExpr(call.ToolCallID, "reject") }>Reject</button>
					<button type="button" data-on:click={ decisionToggleExpr(call.ToolCallID, "approve") } data-class={ decisionClassExpr(call.ToolCallID, "approve") }>Approve</button>
				</div>
			}
		</div>
		<div class="summary">
			if len(approvalSummaryFields(call)) == 0 && strings.TrimSpace(call.ParamsInspect) != "" {
				<div class="label">Params</div><div class="value">{ call.ParamsInspect }</div>
			} else {
				for _, field := range approvalSummaryFields(call) {
					<div class="label">{ field[0] }</div><div class="value">{ field[1] }</div>
				}
			}
		</div>
		<details id={ approvalDetailsID(call.ToolCallID) } data-preserve-attr="open">
			<summary>Details</summary>
			<div class="details-grid">
				<div class="label">Tool call</div><div>{ firstNonEmpty(call.FullToolName, call.ToolName) }</div>
				<div class="label">Call ID</div><div>{ call.ToolCallID }</div>
				<div class="label">Cell</div><div>{ call.CellID }</div>
				<div class="label">Requested</div><div>{ displayTime(call.CreatedAt) }</div>
			</div>
			<div class="label">Raw params</div>
			<pre>{ call.ParamsInspect }</pre>
		</details>
	</div>
}

templ ApprovalFooter(session approvalConsoleSession) {
	<div class="footer">
		<div class="counts">
			<span data-text={ sessionDecisionCountExpr(session, "approve") }>0</span> approve -
			<span data-text={ sessionDecisionCountExpr(session, "reject") }>0</span> reject -
			<span data-text={ sessionUnchangedCountExpr(session) }>{ fmt.Sprintf("%d", countConsoleSessionCalls(session)) }</span> unchanged
		</div>
		<button type="button" data-on:click={ clearSessionDraftsExpr(session) }>Clear choices</button>
		<button type="button" class="primary" data-on:click={ submitSessionExpr(session) } data-attr:disabled={ sessionSubmitDisabledExpr(session) } data-text={ sessionSubmitLabelExpr(session) }>Submit 0 decisions</button>
	</div>
}

templ RejectDialog() {
	<dialog id="reject-dialog" data-effect="$rejectDialogOpen ? (!el.open && el.showModal()) : (el.open && el.close())">
		<h3 data-text={ rejectDialogTitleExpr() }>Reject approvals?</h3>
		<label for="reject-reason">Reason</label>
		<textarea id="reject-reason" placeholder="Optional reason" data-bind:reject-reason></textarea>
		<div class="dialog-actions">
			<button type="button" data-on:click={ cancelRejectDialogExpr() }>Cancel</button>
			<button type="button" class="primary" data-on:click={ submitRejectDialogExpr() }>Submit decisions</button>
		</div>
	</dialog>
}
