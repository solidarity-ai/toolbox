{
  "manifestSchemaVersion": 1,
  "minimumToolboxVersion": "v1.0.0",
  "packedByToolboxVersion": "v1.0.0",
  "module": "fixtures.local/auth-test",
  "name": "auth-test",
  "runtime": "typescript-sandbox",
  "sha256": "ab2fc6829f58ab0f798941de675262777a92fa32cfcc3bd2ecbd94e68f10dc9c",
  "tools": [
    {
      "entry_ts": "tools/auth-test.get.ts",
      "idempotent": true,
      "effect": "readOnly"
    },
    {
      "entry_ts": "tools/auth-test.multi-fetch.ts",
      "idempotent": true,
      "effect": "readOnly",
      "description": "Fetches from two URLs and returns both responses.\nUsed to test that different credentials are injected for different hosts."
    }
  ],
  "credentials": [
    {
      "name": "test_api",
      "type": "api_key",
      "inject": {
        "hosts": [
          "127.0.0.1"
        ],
        "method": "api_key_header",
        "path_prefix": "/api/",
        "allow_unsafe_http_injection": true
      }
    },
    {
      "name": "test_oauth",
      "type": "oauth2",
      "provider": {
        "name": "google",
        "auth_params": {
          "access_type": "offline",
          "prompt": "consent"
        }
      },
      "scopes": [
        "https://www.googleapis.com/auth/admin.directory.user.readonly"
      ],
      "inject": {
        "hosts": [
          "localhost"
        ],
        "method": "bearer_header",
        "path_prefix": "/secured/",
        "allow_unsafe_http_injection": true
      }
    }
  ],
  "allowed_hosts": [
    "127.0.0.1",
    "localhost"
  ]
}
