{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "runtime",
    "tools"
  ],
  "properties": {
    "module": {
      "type": "string",
      "minLength": 1,
      "description": "Fully qualified module identity used for registry resolution and package-scoped secret namespaces."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Package name used as the tool namespace prefix."
    },
    "runtime": {
      "type": "string",
      "enum": [
        "typescript-sandbox",
        "typescript+wasix-sandbox",
        "typescript+wasip2-sandbox"
      ],
      "description": "Execution runtime for the tool's TypeScript code."
    },
    "additionalTypeScriptGlobs": {
      "type": "array",
      "description": "Extra glob patterns for TypeScript files to include beyond tool entries.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sha256": {
      "type": "string"
    },
    "executables": {
      "type": "object",
      "description": "Map of binary name to WASM file path for WASM-based tools.",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowed_hosts": {
      "type": "array",
      "description": "Default outbound host allowlist for all tools in the package.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "credentials": {
      "type": "array",
      "description": "Declarative credential metadata only. Live secret values never appear here.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "type",
          "inject"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "oauth2",
              "api_key",
              "bearer",
              "custom"
            ]
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "strategy": {
            "type": "string",
            "minLength": 1
          },
          "authHosts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "inject": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "hosts"
            ],
            "properties": {
              "hosts": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "pathPrefix": {
                "type": "string",
                "minLength": 1
              },
              "method": {
                "type": "string",
                "enum": [
                  "bearer_header",
                  "basic_auth",
                  "api_key_header",
                  "api_key_query"
                ],
                "description": "Built-in transport injection method."
              },
              "headerName": {
                "type": "string",
                "minLength": 1,
                "description": "Header name used when method is api_key_header."
              },
              "queryName": {
                "type": "string",
                "minLength": 1,
                "description": "Query parameter name used when method is api_key_query."
              }
            }
          }
        }
      }
    },
    "tools": {
      "type": "array",
      "description": "Tool definitions. Each tool has an entry TypeScript file.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entry_ts",
          "effect"
        ],
        "properties": {
          "entry_ts": {
            "type": "string",
            "minLength": 1,
            "description": "Path to the tool's TypeScript entry file, relative to the package root."
          },
          "effect": {
            "type": "string",
            "enum": [
              "readOnly",
              "reversible",
              "irreversible"
            ],
            "description": "Data access level. readOnly: no side effects (e.g. list, get, search). reversible: creates data that can be undone (e.g. create draft, add tag). irreversible: may edit or delete data, or cause irreversible side effects (e.g. send message, update record, delete)."
          },
          "idempotent": {
            "type": "boolean",
            "description": "Whether calling this tool multiple times with the same input produces the same result."
          },
          "description": {
            "type": "string",
            "description": "Human-readable description of what the tool does."
          },
          "paramsSchema": {
            "type": "object",
            "description": "JSON Schema for the tool's input parameters."
          },
          "credentials": {
            "type": "array",
            "description": "Tool-scoped credential metadata. Field absent means inherit package credentials, explicit empty means no credentials, explicit entries replace package credentials.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "type",
                "inject"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "oauth2",
                    "api_key",
                    "bearer",
                    "custom"
                  ]
                },
                "provider": {
                  "type": "string",
                  "minLength": 1
                },
                "scopes": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "strategy": {
                  "type": "string",
                  "minLength": 1
                },
                "authHosts": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "inject": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "hosts"
                  ],
                  "properties": {
                    "hosts": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "pathPrefix": {
                      "type": "string",
                      "minLength": 1
                    },
                    "method": {
                      "type": "string",
                      "enum": [
                        "bearer_header",
                        "basic_auth",
                        "api_key_header",
                        "api_key_query"
                      ],
                      "description": "Built-in transport injection method."
                    },
                    "headerName": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Header name used when method is api_key_header."
                    },
                    "queryName": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Query parameter name used when method is api_key_query."
                    }
                  }
                }
              }
            }
          },
          "allowed_hosts": {
            "type": "array",
            "description": "Tool-specific outbound host allowlist that replaces the package default.",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "allowed_hosts_extend": {
            "type": "array",
            "description": "Additional outbound hosts appended to the inherited package allowlist for this tool.",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "runtime": {
            "const": "typescript-sandbox"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "executables"
          ]
        }
      }
    }
  ]
}
