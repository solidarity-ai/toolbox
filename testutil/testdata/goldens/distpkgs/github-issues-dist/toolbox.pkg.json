{
  "module": "github.com/example/github-issues",
  "name": "github-issues",
  "runtime": "typescript-sandbox",
  "sha256": "5bb25360742b67353c2681e5129387f4dae0a26499c50f813929e25476116dcc",
  "additionalTypeScriptGlobs": [
    "tools/shims.ts"
  ],
  "allowed_hosts": [
    "api.github.com"
  ],
  "credentials": [
    {
      "name": "github_token",
      "type": "bearer",
      "inject": {
        "hosts": [
          "api.github.com"
        ],
        "method": "bearer_header"
      }
    }
  ],
  "tools": [
    {
      "entry_ts": "tools/github-issues.get.ts",
      "idempotent": true,
      "effect": "readOnly"
    }
  ]
}
