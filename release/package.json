{
  "name": "toolbox-release-workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm --prefix ./packages/toolbox install --no-package-lock --omit=optional && npm --prefix ./packages/toolbox run build",
    "test": "npm run build && node --test ./packages/toolbox/test/*.test.js",
    "prepare-dist": "npm run build && node ./scripts/prepare-npm-dist.mjs",
    "build-assets": "node ./scripts/build-release-assets.mjs",
    "publish-dist": "node ./scripts/publish-npm.mjs"
  }
}
