{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "runtime", "tools"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "runtime": {
      "type": "string",
      "enum": ["typescript-sandbox", "typescript+wasmer-sandbox"]
    },
    "additionalTypeScriptGlobs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "executables": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entry_ts"],
        "properties": {
          "entry_ts": {
            "type": "string",
            "minLength": 1
          },
          "accessMode": {
            "type": "string",
            "enum": ["readOnly", "appendOnly", "canDestruct"]
          },
          "idempotent": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "runtime": { "const": "typescript-sandbox" }
        }
      },
      "then": {
        "not": {
          "required": ["executables"]
        }
      }
    }
  ]
}
